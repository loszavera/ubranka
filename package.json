    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.21.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --go",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "build:web": "expo export --platform web --clear",
    "build:all": "expo export --platform all --output-dir dist-all --clear",
    "preview": "expo serve --port 4173",
    "test:e2e": "npm run build:web && playwright test",
    "test:private:e2e": "node scripts/private-e2e.mjs",
    "test:backend": "node --experimental-strip-types --test supabase/tests/protocol.test.ts supabase/tests/cleanup.test.ts supabase/tests/database.test.mjs supabase/tests/styling-database.test.mjs supabase/tests/styling-protocol.test.ts supabase/tests/trial-database.test.mjs supabase/tests/trial-protocol.test.ts supabase/tests/pilot-database.test.mjs supabase/tests/pilot-protocol.test.ts supabase/tests/c2-database.test.mjs supabase/tests/c2-admission.test.ts supabase/tests/c2-worker.test.ts",
    "test:codec": "npx --yes deno@2.9.6 test --config supabase/functions/deno.json supabase/tests/png-codec.deno.ts supabase/tests/canonical-jpeg.deno.ts",
    "check:backend": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/wardrobe/index.ts supabase/functions/wardrobe-cleanup/index.ts supabase/functions/visualization-worker/index.ts supabase/functions/visualization-worker/private-worker.ts supabase/functions/canonical-input/index.ts"
  },
  "private": true
}
